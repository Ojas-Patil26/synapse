# Copy to .env.local (real backend) or rely on .env.development (fixtures).

# "true" = in-memory fixture API and mock auth; anything else = real backend + Cognito.
VITE_USE_FIXTURES=false

# API Gateway base URL, no trailing slash. Example: https://abc123.execute-api.us-east-2.amazonaws.com
VITE_API_BASE_URL=

# Cognito user pool (email + password, sign-ups auto-confirmed server-side).
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
