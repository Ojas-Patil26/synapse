# Copy to .env and fill in. Never commit the real file.
# Read by the deploy script (scripts/deploy.mjs) and the local tools in /scripts and /backend.

GEMINI_API_KEY=
SUPERMEMORY_API_KEY=
# MongoDB Atlas connection string (mongodb+srv://USER:PASSWORD@HOST/)
MONGODB_URI=
# Tiger Data (TimescaleDB) connection string (postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require)
TIGERDATA_URL=
AWS_REGION=us-east-2

# Optional deploy-time settings
# SITE_CERT_ARN=        ACM certificate (us-east-1) that attaches the custom domain to CloudFront
# AUTO_CONFIRM_SIGNUPS=true   skip the email code at sign-up (default: false, codes are required)
# AI_DAILY_LIMIT=80     per-user daily limit on AI requests
# INGEST_DAILY_LIMIT=8  per-user daily limit on course uploads
